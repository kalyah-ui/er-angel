# ER Angel -- Node/Vite monorepo (backend/, frontend-kiosk/, frontend-dashboard/, presage-agent/).
# Kept deliberately short: the old Python template ignored every lib/, build/,
# env/, var/ ... folder, which silently hid frontend-kiosk/src/lib/.

# Dependencies and build output
node_modules/
dist/
.vite/
coverage/

# Secrets -- every package reads its own .env; commit only *.example files
.env
.env.*
!.env.example

# Local runtime data: SQLite db + generated ElevenLabs audio cache
backend/data/
*.db
*.db-journal

# Logs
*.log
npm-debug.log*

# OS / editor clutter
.DS_Store
Thumbs.db
.idea/
*.swp

# Terraform (infra/): state holds secrets (object storage keys); vars files hold config
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
