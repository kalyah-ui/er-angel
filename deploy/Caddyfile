# ER Angel -- public entry point on the server. Hostnames come from .env
# (set with deploy/set-hosts.sh), so a custom domain is a config change:
#
#   {$DASHBOARD_ADDRESS}, {$SITE_ADDRESS}  nurse dashboard + /api  (SITE_ADDRESS = old URL, kept as an alias)
#   {$KIOSK_ADDRESS}                       hosted kiosk + /api (kiosk endpoints only)
#
# Access:
#   Dashboard hosts
#     - Browsers log in with the nurse login (DASHBOARD_USER/_PASSWORD_HASH).
#     - The laptop kiosk (http://localhost:5173, cross-origin) sends
#       X-Kiosk-Token instead, and only reaches kiosk endpoints.
#   Kiosk host -- PUBLIC, no login:
#     - Only the kiosk endpoints below are reachable (403 otherwise) -- not the
#       patient list, alerts, nurse calls, or /admin/reset. No token is baked
#       into its bundle: it calls /api on its own origin.
#     - Its API requests are marked X-ER-Angel-Public: kiosk, and the backend
#       rate-limits those per client IP (backend/src/logic/rateLimit.js).
#       /speak only says the kiosk's own lines; Gemini calls are capped per hour.
#   Both: /api/health is open; the backend handles CORS.
#
# Kiosk endpoints, exactly (anchored: no trailing slash, no extra segments):
#   /api/health  /api/checkin  /api/reading  /api/reading/patient/<n>
#   /api/patients/<n>  /api/patients/<n>/recheck  /api/calls/pending
#   /api/calls/<n>/announced  /api/speak
#
# docker-compose.yml refuses to start if any of these values is missing (an
# empty token or hash would otherwise fail open).

# Redacted access log: method, path, status, origin, client IP, basic-auth
# user, and whether an X-Kiosk-Token was sent (yes/no). ALL request headers
# are dropped, so tokens, Authorization and cookies are never written.
# Read it with scripts/logs.ps1.
(access_log) {
	map {http.request.header.X-Kiosk-Token} {kiosk_token_sent} {
		~.+ yes
		default no
	}
	log_append origin {http.request.header.Origin}
	log_append kiosk_token_sent {kiosk_token_sent}
	log {
		output file {$ACCESS_LOG:/data/logs/access.log} {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 720h
		}
		format filter {
			request>headers delete
			request>tls delete
			resp_headers delete
		}
	}
}

(kiosk_api_paths) {
	path_regexp ^/api/(health|checkin|reading|reading/patient/[0-9]+|patients/[0-9]+|patients/[0-9]+/recheck|calls/pending|calls/[0-9]+/announced|speak)$
}

# ---------- nurse dashboard ----------
{$DASHBOARD_ADDRESS}, {$SITE_ADDRESS} {
	encode zstd gzip
	import access_log

	@needsLogin {
		not {
			path /api/*
			method OPTIONS
		}
		not path /api/health
		not {
			import kiosk_api_paths
			header X-Kiosk-Token {$KIOSK_TOKEN}
		}
	}

	basic_auth @needsLogin {
		{$DASHBOARD_USER} {$DASHBOARD_PASSWORD_HASH}
	}

	handle_path /api/* {
		reverse_proxy {$BACKEND_UPSTREAM:backend:4000} {
			# Only the kiosk host may mark requests as public-kiosk traffic.
			header_up -X-ER-Angel-Public
		}
	}

	handle {
		root * {$SITE_ROOT:/srv}/dashboard
		try_files {path} /index.html
		file_server
	}
}

# ---------- hosted kiosk ----------
{$KIOSK_ADDRESS} {
	encode zstd gzip
	import access_log

	@notKioskApi {
		path /api /api/*
		not {
			import kiosk_api_paths
		}
	}

	# route = run in this exact order.
	route {
		respond @notKioskApi "Not available on the kiosk" 403
		handle_path /api/* {
			reverse_proxy {$BACKEND_UPSTREAM:backend:4000} {
				# Set (not appended): the backend rate-limits requests marked this way.
				header_up X-ER-Angel-Public kiosk
			}
		}
		handle {
			root * {$SITE_ROOT:/srv}/kiosk
			try_files {path} /index.html
			file_server
		}
	}
}
