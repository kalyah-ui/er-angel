# ER Angel server config. On a new server, don't copy this by hand: run
#   bash /opt/er-angel/deploy/init-env.sh <root-host>
# which creates /opt/er-angel/.env (chmod 600) from this file with fresh
# secrets. Never commit the real file.
# Local development uses backend/.env instead (same backend keys).

# ---- Public address & access (used by Caddy; compose refuses to start without them)
# Public hostnames -- set all four with: bash deploy/set-hosts.sh <root-host>
# (e.g. 34-47-40-44.sslip.io for testing, then erangel.health). SITE_ADDRESS
# is the root, kept as an alias of the dashboard; every one of the three
# hostnames needs DNS pointing at the server.
SITE_ADDRESS=
DASHBOARD_ADDRESS=
KIOSK_ADDRESS=
# Dashboard login. Hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs.
DASHBOARD_USER=nurse
DASHBOARD_PASSWORD_HASH=''
# Shared secret the kiosk sends as X-Kiosk-Token. Generate with:
#   openssl rand -hex 32
KIOSK_TOKEN=

# ---- Backend
# Browser origins allowed to call the API cross-origin: the laptop kiosk and
# the hosted kiosk (set-hosts.sh writes this).
CORS_ORIGINS=http://localhost:5173

GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# false = rule-based alerts only. init-env.sh sets true when a key is given.
GEMINI_ENABLED=false
# GEMINI_MODEL=            (default: a flash-tier model, see backend/src/services/geminiClient.js)
# GEMINI_FALLBACK_MODEL=
# Max Gemini requests per hour (retries count); beyond it alerts are rule-based.
# Protects the quota now that the kiosk is public. 0 = rule-based only.
GEMINI_MAX_CALLS_PER_HOUR=60

ELEVENLABS_API_KEY=
ELEVENLABS_ENABLED=true

# Recheck reminders: 0.07 = ~1-2 min intervals for a live demo; false = only the kiosk's R key.
RECHECK_TIME_SCALE=1
RECHECK_AUTO=true

# ---- Object Storage (any S3-compatible store): voice cache + nightly SQLite backups.
# OFF on the Google Cloud server: leave all four unset (the backend logs
# "nightly backups off"); the VM's disk is protected by GCP snapshots instead.
# If a bucket is added later, set them with deploy/set-storage-env.sh.
# Note: Google Cloud Storage's S3 API has no multi-object delete, which backup
# pruning uses (objectStorage.js remove()) -- that would need a small change.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nightly backup time (UTC hour). 7 = 3 AM Toronto (EDT).
BACKUP_HOUR_UTC=7
