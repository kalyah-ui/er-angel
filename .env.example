# ER Angel server config -- copy to .env on the server (/opt/er-angel/.env),
# fill in, and `chmod 600 .env`. Never commit the real file.
# Local development uses backend/.env instead (same backend keys).

# ---- Public address & access (used by Caddy; compose refuses to start without them)
# Public hostnames -- set all four with: bash deploy/set-hosts.sh <root-host>
# (e.g. 203-0-113-5.sslip.io, or a custom domain later). SITE_ADDRESS is the
# original URL, kept as an alias of the dashboard.
SITE_ADDRESS=
DASHBOARD_ADDRESS=
KIOSK_ADDRESS=
# Dashboard login. Hash with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains $ signs.
DASHBOARD_USER=nurse
DASHBOARD_PASSWORD_HASH=''
# Shared secret the kiosk sends as X-Kiosk-Token. Generate with:
#   openssl rand -hex 24
KIOSK_TOKEN=
# Hosted kiosk DEVICE login (separate from the nurse login). Set with:
#   bash deploy/set-kiosk-device-password.sh   (password -> /root/er-angel-kiosk-device-password)
KIOSK_DEVICE_USER=kiosk
KIOSK_DEVICE_PASSWORD_HASH=''

# ---- Backend
# Browser origins allowed to call the API cross-origin: the laptop kiosk and
# the hosted kiosk (set-hosts.sh writes this).
CORS_ORIGINS=http://localhost:5173

GEMINI_API_KEY=
# GEMINI_API_KEY_2=
GEMINI_ENABLED=false

ELEVENLABS_API_KEY=
ELEVENLABS_ENABLED=true

# Recheck reminders: 0.07 = ~1-2 min intervals for a live demo; false = only the kiosk's R key.
RECHECK_TIME_SCALE=1
RECHECK_AUTO=true

# ---- Object Storage (Vultr, S3-compatible): voice cache + nightly SQLite backups.
# Filled in by infra/push-storage-keys.ps1 from Terraform outputs -- don't type the keys by hand.
# Leave unset to run without it (local dev).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Nightly backup time (UTC hour). 7 = 3 AM Toronto (EDT).
BACKUP_HOUR_UTC=7
