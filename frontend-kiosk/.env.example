# LAPTOP kiosk (npm run dev, http://localhost:5173) -> hosted backend.
# Copy to frontend-kiosk/.env.local (never committed), fill in, then restart
# `npm run dev`. Leave unset for local development.
#
# (The HOSTED kiosk, https://kiosk.<server>, needs none of this: it uses its
# own device login and never contains the token.)

# The server's address + /api, e.g. https://203-0-113-5.sslip.io/api
VITE_API_URL=
# Must equal KIOSK_TOKEN in the server's .env
VITE_KIOSK_TOKEN=
# Presage agent on this laptop (default shown)
# VITE_PRESAGE_URL=http://localhost:4600
