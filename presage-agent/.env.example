# presage-agent settings. Copy to presage-agent/.env (never committed).
PRESAGE_API_KEY=

# Extra kiosk pages allowed to use this camera agent (comma-separated).
# http://localhost:5173 (the laptop kiosk) is always allowed. Add the hosted
# kiosk to use it from https://kiosk.<server>:
# KIOSK_ORIGINS=https://kiosk.149-248-60-145.sslip.io
KIOSK_ORIGINS=
